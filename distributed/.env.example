# Database Credentials
DB_ROOT_PASSWORD=your_secure_root_password
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password

# Database Names
AUTH_DB_NAME=auth_db
TOURNAMENT_DB_NAME=tournament_db
TEAM_DB_NAME=team_db
MATCH_DB_NAME=match_db
RESULTS_DB_NAME=results_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Service Ports
AUTH_SERVICE_PORT=8001
TOURNAMENT_SERVICE_PORT=8002
TEAM_SERVICE_PORT=8003
MATCH_SERVICE_PORT=8004
RESULTS_SERVICE_PORT=8005

# Frontend Ports
ADMIN_DASHBOARD_PORT=3000
PUBLIC_VIEW_PORT=3001
PHPMYADMIN_PORT=8082

# Pusher Configuration (for WebSocket) - Get from https://pusher.com/
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=your_pusher_cluster

# Service URLs (Internal Docker Network)
AUTH_SERVICE_URL=http://auth-service:8001
TOURNAMENT_SERVICE_URL=http://tournament-service:8002
TEAM_SERVICE_URL=http://team-service:8003
MATCH_SERVICE_URL=http://match-service:8004
RESULTS_SERVICE_URL=http://results-service:8005

# Service URLs (External Access)
VITE_AUTH_SERVICE_URL=http://localhost:8001/api
VITE_TOURNAMENT_SERVICE_URL=http://localhost:8002/api
VITE_TEAM_SERVICE_URL=http://localhost:8003/api
VITE_MATCH_SERVICE_URL=http://localhost:8004/api
VITE_RESULTS_SERVICE_URL=http://localhost:8005/api

# Pusher Frontend Configuration
VITE_PUSHER_APP_KEY=your_pusher_app_key
VITE_PUSHER_APP_CLUSTER=your_pusher_cluster
VITE_PUSHER_ENCRYPTED=true

# Cache and Queue Configuration
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis

# Broadcast Driver
BROADCAST_DRIVER=pusher

# phpMyAdmin Configuration
PMA_HOSTS=auth-db,tournament-db,team-db,match-db,results-db
PMA_PORTS=3306,3306,3306,3306,3306
PMA_USER=root
PMA_PASSWORD=your_secure_root_password
UPLOAD_LIMIT=300M
